generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

model Client {
  id           String      @id @default(cuid())
  name         String      @unique
  slug         String      @unique
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  formConfig   Json?       @default("{}")
  examCenters  String[]    @default([])
  candidates   Candidate[]
}

model User {
  id         String  @id @default(cuid())
  name       String?
  email      String  @unique
  role       Role    @default(OPS)
  vendorName String?
  password   String?
}

model Candidate {
  id               String          @id @default(cuid())
  token            String          @unique @default(uuid())
  name             String?
  employer         String?
  mobileNumber     String?
  employeeId       String?
  status           CandidateStatus @default(PENDING)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  currentStep      CurrentStep     @default(STARTED)
  lastActiveAt     DateTime        @default(now())
  idType           IDType?
  idNumber         String?
  residentialState String?
  city             String?
  pincode          String?
  clientId         String?
  phase            String?         @default("Phase 1")
  isDraCertified   Boolean         @default(false)
  addressLine1     String?
  addressLine2     String?
  bookLanguage     String?
  trainingLanguage String?
  examCenter       String?
  trainingMonth    String?
  client           Client?         @relation(fields: [clientId], references: [id])
  documents        Document[]
}

model Document {
  id              String         @id @default(cuid())
  candidateId     String
  type            DocumentType
  fileUrl         String
  sizeKB          Int
  status          DocumentStatus @default(PENDING)
  rejectionReason String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  candidate       Candidate      @relation(fields: [candidateId], references: [id])
}

model MasterEmployee {
  id                    String   @id @default(cuid())
  employeeId            String   @unique
  employeeName          String?
  state                 String?
  reportingManagerId    String?
  reportingManagerName  String?
  reportingManagerGroup String?
  skipLevelManagerId    String?
  skipLevelManagerName  String?
  activeStatus          String?
  email                 String?
  officeMobileNo        String?
  personalMobileNo      String?
  whatsappNo            String?
  vendor                String?
  region2               String?
  location2             String?
  draBatch              String?
  addressLine1          String?
  addressLine2          String?
  bookLanguage          String?
  trainingLanguage      String?
  examCenter            String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  city                  String?
  pincode               String?
  phase                 String?  @default("Phase 1")
  trainingMonth         String?
}

model AddressRecord {
  id            String    @id @default(cuid())
  employeeId    String    @unique
  phoneNumber   String?
  name          String?
  companyAgency String?
  city          String
  state         String
  pincode       String
  createdAt     DateTime  @default(now())
  bookLanguage  String    @default("English")
  addressLine1  String
  addressLine2  String?
  addressLine3  String?
  updatedAt     DateTime? @updatedAt
}

model SystemSetting {
  id    String @id @default(cuid())
  key   String @unique
  value String
}

model BookDeliveryMaster {
  id                    String   @id @default(cuid())
  employeeId            String   @unique
  employeeName          String
  state                 String?
  reportingManagerId    String?
  reportingManagerName  String?
  reportingManagerGroup String?
  skipLevelManagerId    String?
  skipLevelManagerName  String?
  activeStatus          String?
  email                 String?
  officeMobileNo        String?
  personalMobileNo      String?
  whatsappNo            String?
  vendor                String?
  phase                 String?   @default("Phase 1")
  region2               String?
  location2             String?
  city                  String?
  pincode               String?
  draBatch              String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model BookDispatched {
  id           String   @id @default(cuid())
  employeeId   String   @unique
  dispatchedAt DateTime @default(now())
}

enum Role {
  OPS
  VALIDATOR
  TL
  ADMIN
  VENDOR
  SUPERADMIN
}

enum CandidateStatus {
  PENDING
  OPS_VERIFIED
  VALIDATED
  REJECTED
  READY
}

enum DocumentType {
  PHOTO
  QUALIFICATION
  ID_PROOF
  SIGNATURE
  ID_PROOF_FRONT
  ID_PROOF_BACK
  DRA_CERTIFICATE
}

enum IDType {
  PAN
  AADHAAR
  DL
  PASSPORT
}

enum DocumentStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum CurrentStep {
  STARTED
  PERSONAL_INFO_DONE
  UPLOADING_DOCS
  COMPLETED
}

// ─────────────────────────────────────────────
// SAAS MULTI-TENANT MODELS
// ─────────────────────────────────────────────

model Organization {
  id                    String        @id @default(cuid())
  name                  String
  slug                  String        @unique
  plan                  OrgPlan       @default(TRIAL)
  subscription_status   SubStatus     @default(TRIAL)
  trial_ends_at         DateTime
  billing_cycle_end     DateTime?
  cashfree_sub_id       String?
  logo_url              String?
  brand_color           String        @default("#2563eb")
  email_provider        EmailProvider @default(AICLEX)
  smtp_host             String?
  smtp_port             Int?
  smtp_user             String?
  smtp_pass             String?
  resend_api_key        String?
  from_email            String?
  candidates_this_month Int           @default(0)
  storage_used_gb       Float         @default(0)
  is_suspended          Boolean       @default(false)
  owner_email           String
  owner_name            String
  users                 OrgUser[]
  campaigns             Campaign[]
  org_candidates        OrgCandidate[]
  audit_logs            AuditLog[]
  created_at            DateTime      @default(now())
  updated_at            DateTime      @updatedAt
}

model OrgUser {
  id          String       @id @default(cuid())
  org_id      String
  org         Organization @relation(fields: [org_id], references: [id])
  email       String
  password    String
  name        String
  role        OrgRole      @default(REVIEWER)
  totp_secret String?
  is_active   Boolean      @default(true)
  last_login  DateTime?
  created_at  DateTime     @default(now())

  @@unique([org_id, email])
}

model PlanConfig {
  id                       String   @id @default(cuid())
  plan                     OrgPlan  @unique
  max_users                Int
  max_candidates_per_month Int
  max_storage_gb           Float
  max_campaigns            Int
  whatsapp_button          Boolean
  custom_branding          Boolean
  ai_validation            Boolean
  audit_logs_enabled       Boolean
  api_access               Boolean
  custom_smtp              Boolean
  two_fa                   Boolean
  price_monthly            Int
  updated_at               DateTime @updatedAt
}

model Campaign {
  id             String         @id @default(cuid())
  org_id         String
  org            Organization   @relation(fields: [org_id], references: [id])
  name           String
  slug           String
  description    String?
  required_docs  Json           @default("[]")
  is_active      Boolean        @default(true)
  created_at     DateTime       @default(now())
  updated_at     DateTime       @updatedAt
  org_candidates OrgCandidate[]

  @@unique([org_id, slug])
}

model OrgCandidate {
  id          String             @id @default(cuid())
  org_id      String
  org         Organization       @relation(fields: [org_id], references: [id])
  campaign_id String
  campaign    Campaign           @relation(fields: [campaign_id], references: [id])
  token       String             @unique @default(uuid())
  name        String?
  email       String?
  phone       String?
  status      OrgCandidateStatus @default(PENDING)
  documents   OrgDocument[]
  notes       String?
  created_at  DateTime           @default(now())
  updated_at  DateTime           @updatedAt
}

model OrgDocument {
  id               String           @id @default(cuid())
  org_candidate_id String
  org_candidate    OrgCandidate     @relation(fields: [org_candidate_id], references: [id])
  doc_type         String
  file_url         String
  size_kb          Int
  status           DocumentStatus   @default(PENDING)
  rejection_reason String?
  created_at       DateTime         @default(now())
  updated_at       DateTime         @updatedAt
}

model AuditLog {
  id         String       @id @default(cuid())
  org_id     String
  org        Organization @relation(fields: [org_id], references: [id])
  user_id    String?
  action     String
  details    Json?
  ip_address String?
  created_at DateTime     @default(now())
}

model SuperAdmin {
  id         String   @id @default(cuid())
  email      String   @unique
  password   String
  created_at DateTime @default(now())
}

enum OrgPlan {
  TRIAL
  STARTER
  PROFESSIONAL
  ENTERPRISE
}
enum SubStatus {
  TRIAL
  ACTIVE
  GRACE
  EXPIRED
  CANCELLED
}
enum OrgRole {
  ORG_ADMIN
  REVIEWER
  VIEWER
}
enum EmailProvider {
  AICLEX
  SMTP
  RESEND
}
enum OrgCandidateStatus {
  PENDING
  DOCS_COMPLETE
  UNDER_REVIEW
  APPROVED
  REJECTED
}
